node_modules/
dist/
coverage/
.turbo/
.stryker-tmp/
reports/
*.tsbuildinfo
*.log
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# `next build` output. The nextjs e2e runs a REAL build (packages/nextjs-e2e), so anyone who runs it —
# or who builds the sample to measure something — is left with a tree of generated JSON that fails
# `biome check .` by the thousand.
.next/

# tsup writes a bundled config next to the package when tsup.config.ts needs transpiling, and leaves
# it behind if the build is interrupted. Untracked, it fails `biome check .` on a formatting rule.
tsup.config.bundled_*.mjs

# Pre-publish tarballs the sample apps install from (scripts/pack-local.mjs).
.local-registry/

# Sample apps are standalone pnpm projects with their own (dev-only) lockfiles.
samples/*/node_modules/
samples/*/pnpm-lock.yaml

# Session scratch: review harnesses, benchmarks and file backups. Not part of the SDK.
.session-artifacts/

# Agent worktrees + local session files. A worktree here contains a full copy of the repo,
# INCLUDING its biome.json — which Biome treats as a nested root and refuses to lint past,
# taking down `pnpm lint` for the whole repo.
.claude/
