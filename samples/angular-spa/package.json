{
  "name": "@bugsee-samples/angular-spa",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "dev:api": "node server/api-server.mjs",
    "dev:app": "cross-env APP_BUILD=dev node scripts/generate-environment.mjs && ng serve",
    "dev": "concurrently -k -n api,app -c yellow,cyan \"pnpm dev:api\" \"pnpm dev:app\"",
    "build": "node scripts/bump-build-counter.mjs && node scripts/generate-environment.mjs && ng build",
    "preview": "cross-env PORT=5306 STATIC_DIR=dist/angular-spa/browser node server/api-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@angular/animations": "^18.2.0",
    "@angular/common": "^18.2.0",
    "@angular/compiler": "^18.2.0",
    "@angular/core": "^18.2.0",
    "@angular/forms": "^18.2.0",
    "@angular/platform-browser": "^18.2.0",
    "@angular/platform-browser-dynamic": "^18.2.0",
    "@angular/router": "^18.2.0",
    "@bugsee/angular": "file:../../.local-registry/bugsee-angular.tgz",
    "@bugsee/util": "file:../../.local-registry/bugsee-util.tgz",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.21",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.0",
    "@bugsee/performance": "file:../../.local-registry/bugsee-performance.tgz",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "playwright": "^1.49.1",
    "typescript": "~5.5.2",
    "ws": "^8.18.0"
  }
}
