{
  "name": "@bugsee-samples/browser-vanilla",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5301",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --port 5301",
    "verify": "tsx scripts/verify.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "@bugsee/bugsee": "file:../../.local-registry/bugsee-bugsee.tgz",
    "@bugsee/replay": "file:../../.local-registry/bugsee-replay.tgz",
    "@bugsee/replay-canvas": "file:../../.local-registry/bugsee-replay-canvas.tgz",
    "@bugsee/webworker": "file:../../.local-registry/bugsee-webworker.tgz",
    "@bugsee/opentelemetry": "file:../../.local-registry/bugsee-opentelemetry.tgz",
    "@bugsee/performance": "file:../../.local-registry/bugsee-performance.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.10",
    "dotenv": "^16.4.5",
    "playwright": "^1.47.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "ws": "^8.18.0"
  }
}
