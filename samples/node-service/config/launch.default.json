{
  "_comment": "Default launch profile — every BugseeLaunchOptions field exercised at a sample-friendly value. Loaded by src/bugsee-client.ts. Select with BUGSEE_PROFILE=default (the default).",
  "captureLogs": true,
  "captureNetwork": true,
  "unhandledRejections": "preserve",
  "captureNetworkBodies": true,
  "maxNetworkBodySize": 20480,
  "captureNetworkBodyWithoutType": false,
  "propagateTrace": true,
  "tracePropagationTargets": ["localhost", "127.0.0.1"],
  "traceResponse": { "traceresponse": true, "serverTiming": true },
  "captureSystemTraces": true,
  "captureSystemEvents": true,
  "detectCrashes": true,
  "detectHangs": true,
  "hangFairMs": 800,
  "hangMediumMs": 1600,
  "hangSevereMs": 2600,
  "profiling": true,
  "profilingSamplingIntervalMicros": 1000,
  "maxRecordingTime": 60,
  "maxDataSize": 50,
  "capturedDataStore": "disk",
  "captureWriter": "inline",
  "shutdownTimeoutMs": 3000,
  "exitOnUncaught": true,
  "recover": true,
  "instrumentIncomingRequests": true,
  "performanceMonitoring": true,
  "performanceSampleRate": 1,
  "performanceFlushIntervalMs": 5000,
  "otelConsume": true
}
