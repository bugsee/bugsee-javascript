{
  "name": "@bugsee/browser",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Browser platform: fetch transport, IndexedDB storage, error handlers, stack-trace parser",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/browser-utils": "workspace:*",
    "@bugsee/capture": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/integration-shims": "workspace:*",
    "@bugsee/protocol": "workspace:*",
    "@bugsee/replay": "workspace:*",
    "@bugsee/replay-canvas": "workspace:*"
  },
  "devDependencies": {
    "@bugsee/util": "workspace:*",
    "fake-indexeddb": "^6.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
