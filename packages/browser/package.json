{
  "name": "@bugsee/browser",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Browser platform: fetch transport, IndexedDB storage, error handlers, stack-trace parser",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/capture": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/browser-utils": "workspace:*",
    "@bugsee/integration-shims": "workspace:*",
    "@bugsee/protocol": "workspace:*"
  }
}
