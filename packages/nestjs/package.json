{
  "name": "@bugsee/nestjs",
  "version": "0.1.0-beta.2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/nestjs"
  },
  "description": "NestJS adapter",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "//sideEffects": "intentionally omitted (defaults to true): filter.ts applies Catch() metadata at module load — a sideEffects:false hint would let a consumer's bundler tree-shake that side effect away and break the global ExceptionFilter.",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@bugsee/bugsee": "workspace:*",
    "@bugsee/capture": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/node": "workspace:*",
    "@bugsee/performance": "workspace:*",
    "@bugsee/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^9 || ^10 || ^11",
    "@nestjs/core": "^9 || ^10 || ^11",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@bugsee/util": "workspace:*",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/platform-express": "^10.4.22",
    "@types/node": "^22.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@nestjs/platform-fastify": "^10.4.22"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  }
}
