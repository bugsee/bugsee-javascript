{
  "name": "@bugsee/sveltekit",
  "version": "0.1.0-beta.2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/sveltekit"
  },
  "description": "SvelteKit meta-adapter: portable handleError + handle (ALS context + trace) + server/client/edge entries",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./edge": {
      "types": "./src/edge.ts",
      "import": "./src/edge.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./server": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "./client": {
        "import": {
          "types": "./dist/client.d.ts",
          "default": "./dist/client.js"
        },
        "require": {
          "types": "./dist/client.d.cts",
          "default": "./dist/client.cjs"
        }
      },
      "./edge": {
        "import": {
          "types": "./dist/edge.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/edge.d.cts",
          "default": "./dist/edge.cjs"
        }
      }
    },
    "access": "public"
  },
  "dependencies": {
    "@bugsee/adapter-kit": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/svelte": "workspace:*",
    "@bugsee/vercel-edge": "workspace:*",
    "@bugsee/bugsee": "workspace:*"
  },
  "devDependencies": {
    "@bugsee/node": "workspace:*",
    "@sveltejs/kit": "^2.0.0"
  }
}
