{
  "name": "@bugsee/sveltekit",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "SvelteKit meta-adapter: portable handleError + handle (ALS context + trace) + server/client/edge entries",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/adapter-kit": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/svelte": "workspace:*",
    "bugsee": "workspace:*"
  },
  "devDependencies": {
    "@bugsee/node": "workspace:*",
    "@sveltejs/kit": "^2.0.0"
  }
}
