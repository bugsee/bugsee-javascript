{
  "name": "@bugsee/instrumentation-tests",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-runtime end-to-end instrumentation harness: boots the real SDK under node/bun/deno against a mock collector and asserts the uploaded bundle.",
  "type": "module",
  "scripts": {
    "test:e2e": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bugsee/browser": "workspace:*",
    "@bugsee/bugsee": "workspace:*",
    "@bugsee/bun": "workspace:*",
    "@bugsee/cloudflare": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/deno": "workspace:*",
    "@bugsee/e2e-kit": "workspace:*",
    "@bugsee/node": "workspace:*",
    "@bugsee/performance": "workspace:*",
    "@bugsee/protocol": "workspace:*",
    "@bugsee/replay": "workspace:*",
    "@bugsee/util": "workspace:*",
    "@bugsee/vercel-edge": "workspace:*",
    "@bugsee/vite-plugin": "workspace:*",
    "@bugsee/webview": "workspace:*"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.27.0",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.1",
    "miniflare": "^4.20260722.0",
    "tsx": "^4.19.0"
  }
}
