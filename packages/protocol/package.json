{
  "name": "@bugsee/protocol",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Canonical wire shapes: types + sanitizer lists + shape redaction + option-key translator + enum maps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./upload-contract.schema.json": "./upload-contract.schema.json",
    "./source-line-redaction.vectors.json": "./source-line-redaction.vectors.json"
  },
  "files": [
    "dist",
    "upload-contract.schema.json",
    "source-line-redaction.vectors.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/types": "workspace:*",
    "@bugsee/util": "workspace:*"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./upload-contract.schema.json": "./upload-contract.schema.json",
      "./source-line-redaction.vectors.json": "./source-line-redaction.vectors.json"
    }
  }
}
