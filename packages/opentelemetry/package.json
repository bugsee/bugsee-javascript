{
  "name": "@bugsee/opentelemetry",
  "version": "0.1.0-beta.2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/opentelemetry"
  },
  "description": "OpenTelemetry interop (Tier 3, pluggable extension): two-way bridge — produce Bugsee transactions as OTLP/JSON, consume OTel spans. Runtime-portable mapping core; OTel deps are peers in the per-runtime wiring. See docs/design/opentelemetry-integration.md",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/capture": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/performance": "workspace:*"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.0.0",
    "@opentelemetry/sdk-trace-base": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  }
}
