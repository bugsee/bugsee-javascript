{
  "name": "@bugsee/bugsee",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Batteries-included umbrella: the platform composition root + the on-by-default extensions (performance + opentelemetry) wired in, with per-runtime (browser/node) exports conditions",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "bun": {
        "types": "./src/index.bun.ts",
        "import": "./src/index.bun.ts"
      },
      "deno": {
        "types": "./src/index.deno.ts",
        "import": "./src/index.deno.ts"
      },
      "browser": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "node": {
        "types": "./src/index.node.ts",
        "import": "./src/index.node.ts"
      },
      "default": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      }
    },
    "./node": {
      "types": "./src/index.node.ts",
      "import": "./src/index.node.ts"
    },
    "./bun": {
      "types": "./src/index.bun.ts",
      "import": "./src/index.bun.ts"
    },
    "./deno": {
      "types": "./src/index.deno.ts",
      "import": "./src/index.deno.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "main": "./dist/index.node.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "bun": {
          "import": {
            "types": "./dist/index.bun.d.ts",
            "default": "./dist/index.bun.js"
          },
          "require": {
            "types": "./dist/index.bun.d.cts",
            "default": "./dist/index.bun.cjs"
          }
        },
        "deno": {
          "import": {
            "types": "./dist/index.deno.d.ts",
            "default": "./dist/index.deno.js"
          },
          "require": {
            "types": "./dist/index.deno.d.cts",
            "default": "./dist/index.deno.cjs"
          }
        },
        "browser": {
          "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
          },
          "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
          }
        },
        "node": {
          "import": {
            "types": "./dist/index.node.d.ts",
            "default": "./dist/index.node.js"
          },
          "require": {
            "types": "./dist/index.node.d.cts",
            "default": "./dist/index.node.cjs"
          }
        },
        "default": {
          "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
          },
          "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
          }
        }
      },
      "./node": {
        "import": {
          "types": "./dist/index.node.d.ts",
          "default": "./dist/index.node.js"
        },
        "require": {
          "types": "./dist/index.node.d.cts",
          "default": "./dist/index.node.cjs"
        }
      },
      "./bun": {
        "import": {
          "types": "./dist/index.bun.d.ts",
          "default": "./dist/index.bun.js"
        },
        "require": {
          "types": "./dist/index.bun.d.cts",
          "default": "./dist/index.bun.cjs"
        }
      },
      "./deno": {
        "import": {
          "types": "./dist/index.deno.d.ts",
          "default": "./dist/index.deno.js"
        },
        "require": {
          "types": "./dist/index.deno.d.cts",
          "default": "./dist/index.deno.cjs"
        }
      }
    }
  },
  "dependencies": {
    "@bugsee/browser": "workspace:*",
    "@bugsee/bun": "workspace:*",
    "@bugsee/capture": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/deno": "workspace:*",
    "@bugsee/node": "workspace:*",
    "@bugsee/opentelemetry": "workspace:*",
    "@bugsee/performance": "workspace:*",
    "@bugsee/protocol": "workspace:*"
  }
}
