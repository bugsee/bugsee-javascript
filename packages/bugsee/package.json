{
  "name": "bugsee",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Batteries-included umbrella: the platform composition root + the on-by-default extensions (performance + opentelemetry) wired in, with per-runtime (browser/node) exports conditions",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "node": {
        "types": "./src/index.node.ts",
        "import": "./src/index.node.ts"
      },
      "default": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "main": "./dist/index.node.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "browser": {
          "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
          },
          "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
          }
        },
        "node": {
          "import": {
            "types": "./dist/index.node.d.ts",
            "default": "./dist/index.node.js"
          },
          "require": {
            "types": "./dist/index.node.d.cts",
            "default": "./dist/index.node.cjs"
          }
        },
        "default": {
          "import": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
          },
          "require": {
            "types": "./dist/index.d.cts",
            "default": "./dist/index.cjs"
          }
        }
      }
    }
  },
  "dependencies": {
    "@bugsee/core": "workspace:*",
    "@bugsee/browser": "workspace:*",
    "@bugsee/node": "workspace:*",
    "@bugsee/opentelemetry": "workspace:*",
    "@bugsee/performance": "workspace:*"
  }
}
