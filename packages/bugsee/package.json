{
  "name": "bugsee",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Batteries-included umbrella: the platform composition root + the on-by-default extensions (performance) wired in (browser entry today; per-runtime exports conditions to follow)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/core": "workspace:*",
    "@bugsee/browser": "workspace:*",
    "@bugsee/performance": "workspace:*"
  }
}
