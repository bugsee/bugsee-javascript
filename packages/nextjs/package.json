{
  "name": "@bugsee/nextjs",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Next.js meta-adapter: client + server + edge entries",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./edge": {
      "types": "./src/edge.ts",
      "import": "./src/edge.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "import": "./src/middleware.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/core": "workspace:*",
    "@bugsee/react": "workspace:*",
    "@bugsee/vercel-edge": "workspace:*",
    "bugsee": "workspace:*"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.0.0",
    "@opentelemetry/sdk-trace-base": ">=1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    },
    "@opentelemetry/sdk-trace-base": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bugsee/node": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./server": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "./client": {
        "import": {
          "types": "./dist/client.d.ts",
          "default": "./dist/client.js"
        },
        "require": {
          "types": "./dist/client.d.cts",
          "default": "./dist/client.cjs"
        }
      },
      "./edge": {
        "import": {
          "types": "./dist/edge.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/edge.d.cts",
          "default": "./dist/edge.cjs"
        }
      },
      "./middleware": {
        "import": {
          "types": "./dist/middleware.d.ts",
          "default": "./dist/middleware.js"
        },
        "require": {
          "types": "./dist/middleware.d.cts",
          "default": "./dist/middleware.cjs"
        }
      }
    }
  }
}
