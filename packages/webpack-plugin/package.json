{
  "name": "@bugsee/webpack-plugin",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Webpack plugin: drives the Bugsee source-map upload (inject debug-IDs + upload via bugsee-cli) at build end.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/bundler-plugin-core": "workspace:*"
  }
}
