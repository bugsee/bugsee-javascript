{
  "name": "@bugsee/browser-utils",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "fetch transport + IndexedDB storage + DOM helpers shared by browser/web-worker/service-worker",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/core": "workspace:*",
    "@bugsee/protocol": "workspace:*",
    "@bugsee/util": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
