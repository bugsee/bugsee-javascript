{
  "name": "@bugsee/rrweb",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Thin swappable wrapper over the rrweb RECORD path (npm @rrweb/record now; the Bugsee rrweb fork later) — the single rrweb import point for @bugsee/replay + @bugsee/replay-canvas",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rrweb/record": "^2.1.0",
    "@rrweb/types": "^2.1.0",
    "rrweb": "^2.1.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1"
  }
}
