{
  "name": "@bugsee/rrweb",
  "version": "0.1.0-beta.3",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/rrweb"
  },
  "description": "Thin swappable wrapper over the rrweb RECORD path (the Bugsee-hardened rrweb fork) — the single rrweb import point for @bugsee/replay + @bugsee/replay-canvas",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rrweb/types": "^2.2.0",
    "rrweb": "^2.2.0"
  },
  "devDependencies": {
    "@bugsee/rrweb-record": "github:bugsee/rrweb#6a2ba728c2265a42d8837b2ac4ff51e13c883c13",
    "jsdom": "^25.0.1"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  }
}
