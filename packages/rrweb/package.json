{
  "name": "@bugsee/rrweb",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Thin swappable wrapper over the rrweb RECORD path (the Bugsee-hardened rrweb fork) — the single rrweb import point for @bugsee/replay + @bugsee/replay-canvas",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@rrweb/types": "^2.1.0",
    "rrweb": "^2.1.0"
  },
  "devDependencies": {
    "@bugsee/rrweb-record": "github:bugsee/rrweb#d50d8d7e0786e095bfaa12bdaadc59b7447ed920",
    "jsdom": "^25.0.1"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
