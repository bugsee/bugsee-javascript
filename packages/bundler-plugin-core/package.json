{
  "name": "@bugsee/bundler-plugin-core",
  "version": "0.1.0-beta.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/bundler-plugin-core"
  },
  "description": "Shared bundler-plugin core — collects build context and drives the Rust bugsee-cli (sourcemaps inject + debug-files upload). The engine under @bugsee/vite-plugin / @bugsee/webpack-plugin.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/cli": "^0.9.0",
    "@bugsee/core": "workspace:*",
    "acorn": "^8.19.0",
    "magic-string": "^0.30.21",
    "unplugin": "^2.3.10"
  },
  "devDependencies": {
    "@rspack/core": "2.2.9",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "rollup": "^4.65.1",
    "tsup": "^9.0.0",
    "vite": "^8.3.5",
    "vite7": "npm:vite@7.3.6"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  }
}
