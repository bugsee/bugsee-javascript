{
  "name": "@bugsee/bundler-plugin-core",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Shared bundler-plugin core — collects build context and drives the Rust bugsee-cli (sourcemaps inject + debug-files upload). The engine under @bugsee/vite-plugin / @bugsee/webpack-plugin.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/bugsee-cli": "^0.7.2",
    "unplugin": "^2.3.10"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}
