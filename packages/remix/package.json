{
  "name": "@bugsee/remix",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Remix / React Router v7 meta-adapter: server (handleError + node) + client entries",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/adapter-kit": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/react": "workspace:*",
    "@bugsee/bugsee": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bugsee/node": "workspace:*",
    "@types/react": "^18.3.0",
    "react": "^18.3.1"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./server": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "./client": {
        "import": {
          "types": "./dist/client.d.ts",
          "default": "./dist/client.js"
        },
        "require": {
          "types": "./dist/client.d.cts",
          "default": "./dist/client.cjs"
        }
      }
    }
  }
}
