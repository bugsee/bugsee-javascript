{
  "name": "@bugsee/koa",
  "version": "0.1.0-beta.2",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/koa"
  },
  "description": "Koa middleware adapter",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/bugsee": "workspace:*",
    "@bugsee/capture": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/node": "workspace:*",
    "@bugsee/performance": "workspace:*"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@bugsee/util": "workspace:*",
    "@types/node": "^26.6.4",
    "koa": "^2.15.0",
    "@types/koa": "^2.15.0"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    },
    "access": "public"
  }
}
