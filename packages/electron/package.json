{
  "name": "@bugsee/electron",
  "version": "0.1.0-beta.1",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/electron"
  },
  "description": "Electron SDK: converges the main (Node), renderer (Chromium) and native (crashReporter) layers into one Bugsee session. See docs/design/electron.md.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./renderer": {
      "types": "./src/renderer.ts",
      "import": "./src/renderer.ts"
    },
    "./preload": {
      "types": "./src/preload.ts",
      "import": "./src/preload.ts"
    },
    "./main": {
      "types": "./src/main.ts",
      "import": "./src/main.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/browser": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/node": "workspace:*",
    "@bugsee/protocol": "workspace:*"
  },
  "devDependencies": {
    "@bugsee/util": "workspace:*",
    "@types/node": "^25.9.1"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./renderer": {
        "import": {
          "types": "./dist/renderer.d.ts",
          "default": "./dist/renderer.js"
        },
        "require": {
          "types": "./dist/renderer.d.cts",
          "default": "./dist/renderer.cjs"
        }
      },
      "./preload": {
        "import": {
          "types": "./dist/preload.d.ts",
          "default": "./dist/preload.js"
        },
        "require": {
          "types": "./dist/preload.d.cts",
          "default": "./dist/preload.cjs"
        }
      },
      "./main": {
        "import": {
          "types": "./dist/main.d.ts",
          "default": "./dist/main.js"
        },
        "require": {
          "types": "./dist/main.d.cts",
          "default": "./dist/main.cjs"
        }
      }
    },
    "access": "public"
  }
}
