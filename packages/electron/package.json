{
  "name": "@bugsee/electron",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Electron SDK: converges the main (Node), renderer (Chromium) and native (crashReporter) layers into one Bugsee session. See docs/design/electron.md.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/browser": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/node": "workspace:*",
    "@bugsee/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}
