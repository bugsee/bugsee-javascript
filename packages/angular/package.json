{
  "name": "@bugsee/angular",
  "version": "0.1.0-beta.8",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bugsee/bugsee-javascript.git",
    "directory": "packages/angular"
  },
  "description": "Angular adapter: ErrorHandler + Router naming, plus `ng add` and a source-map upload step",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./sourcemaps": {
      "types": "./src/sourcemaps/index.ts",
      "import": "./src/sourcemaps/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/bugsee": "workspace:*",
    "@bugsee/browser": "workspace:*",
    "@bugsee/web-adapter": "workspace:*",
    "@bugsee/bundler-plugin-core": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": ">=16",
    "@angular/router": ">=16",
    "@angular-devkit/schematics": ">=16.1",
    "@schematics/angular": ">=16.1"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/router": {
      "optional": true
    },
    "@angular-devkit/schematics": {
      "optional": true
    },
    "@schematics/angular": {
      "optional": true
    }
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./sourcemaps": {
        "import": {
          "types": "./dist/sourcemaps/index.d.ts",
          "default": "./dist/sourcemaps/index.js"
        },
        "require": {
          "types": "./dist/sourcemaps/index.d.cts",
          "default": "./dist/sourcemaps/index.cjs"
        }
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "bin": {
      "bugsee-angular-upload": "./dist/sourcemaps/bin.js"
    }
  },
  "devDependencies": {
    "@bugsee/core": "workspace:*",
    "@angular-devkit/schematics": "22.0.0",
    "@schematics/angular": "22.0.0",
    "@types/node": "^22.20.5"
  },
  "schematics": "./dist/schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  }
}
