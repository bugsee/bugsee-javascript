{
  "name": "@bugsee/node",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Node platform: http(s) transport, node:fs storage, uncaught/unhandled handlers, ALS",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@bugsee/capture": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/node-utils": "workspace:*",
    "@bugsee/performance": "workspace:*",
    "@bugsee/protocol": "workspace:*"
  },
  "devDependencies": {
    "@bugsee/util": "workspace:*",
    "@types/node": "^25.9.1"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
