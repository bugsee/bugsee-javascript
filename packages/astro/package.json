{
  "name": "@bugsee/astro",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Astro meta-adapter: an Integration (astro:config:setup) wiring a browser launch + a middleware (error capture + trace) + server/edge init",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "import": "./src/middleware.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/adapter-kit": "workspace:*",
    "@bugsee/core": "workspace:*"
  },
  "devDependencies": {
    "astro": "^5.0.0"
  }
}
