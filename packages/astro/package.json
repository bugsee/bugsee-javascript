{
  "name": "@bugsee/astro",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Astro meta-adapter: an Integration (astro:config:setup) wiring a browser launch + a middleware (error capture + trace) + server/edge init",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./middleware": {
      "types": "./src/middleware.ts",
      "import": "./src/middleware.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "import": "./src/client.ts"
    },
    "./edge": {
      "types": "./src/edge.ts",
      "import": "./src/edge.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./middleware": {
        "import": {
          "types": "./dist/middleware.d.ts",
          "default": "./dist/middleware.js"
        },
        "require": {
          "types": "./dist/middleware.d.cts",
          "default": "./dist/middleware.cjs"
        }
      },
      "./server": {
        "import": {
          "types": "./dist/server.d.ts",
          "default": "./dist/server.js"
        },
        "require": {
          "types": "./dist/server.d.cts",
          "default": "./dist/server.cjs"
        }
      },
      "./client": {
        "import": {
          "types": "./dist/client.d.ts",
          "default": "./dist/client.js"
        },
        "require": {
          "types": "./dist/client.d.cts",
          "default": "./dist/client.cjs"
        }
      },
      "./edge": {
        "import": {
          "types": "./dist/edge.d.ts",
          "default": "./dist/edge.js"
        },
        "require": {
          "types": "./dist/edge.d.cts",
          "default": "./dist/edge.cjs"
        }
      }
    }
  },
  "dependencies": {
    "@bugsee/adapter-kit": "workspace:*",
    "@bugsee/core": "workspace:*",
    "@bugsee/protocol": "workspace:*",
    "@bugsee/vercel-edge": "workspace:*",
    "@bugsee/bugsee": "workspace:*"
  },
  "devDependencies": {
    "@bugsee/node": "workspace:*",
    "astro": "^5.0.0"
  }
}
