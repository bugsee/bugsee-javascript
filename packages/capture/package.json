{
  "name": "@bugsee/capture",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Cross-runtime capture sources (console/fetch interceptors) + runtime-agnostic capture providers",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bugsee/core": "workspace:*",
    "@bugsee/protocol": "workspace:*",
    "@bugsee/types": "workspace:*",
    "@bugsee/util": "workspace:*"
  }
}
